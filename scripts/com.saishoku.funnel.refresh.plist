<?xml version="1.0" encoding="UTF-8"?>
<!--
  歩留まりダッシュボード 日次自動更新（launchd エージェント）

  導入手順:
    cp scripts/com.saishoku.funnel.refresh.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.saishoku.funnel.refresh.plist
  解除:
    launchctl unload ~/Library/LaunchAgents/com.saishoku.funnel.refresh.plist

  毎日 08:00(端末ローカル時刻) に GA4+Slack を取得する。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.saishoku.funnel.refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/koretada/Desktop/まさきさん/funnel-dashboard/scripts/daily-refresh.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/koretada/Desktop/まさきさん/funnel-dashboard</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/anaconda3/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/koretada/Desktop/まさきさん/funnel-dashboard/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/koretada/Desktop/まさきさん/funnel-dashboard/logs/launchd.err.log</string>
</dict>
</plist>
